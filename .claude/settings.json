{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(curl -s \"$SUPABASE_URL/rest/v1/* *)",
      "Bash(git rev-list *)",
      "Bash(git push *)",
      "Bash(npx supabase db dump *)",
      "Bash(supabase db dump *)",
      "Bash(npx supabase db query *)",
      "Bash(supabase db query *)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push *)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(npx supabase db dump *)",
      "Bash(supabase db dump *)",
      "Bash(npx supabase db query *)",
      "Bash(supabase db query *)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push *)"
    ]
  }
}